# ─────────────────────────────────────────────────────────────────────────────────────
# Shopping List API — environment configuration
#
# Copy to `.env` and adjust. Every variable here is read by either docker-compose.yml or
# the API; nothing is stale. Grouped keys use the .NET double-underscore convention
# (RedisSettings__AbortOnConnectFail) so the same names work as environment variables,
# in secrets.json locally, and through the .NET configuration system unchanged.
#
# The values below are working development defaults — the stack comes up with them as-is.
# They are NOT secrets and must never be used outside local development.
# ─────────────────────────────────────────────────────────────────────────────────────

# ── Host port mappings ───────────────────────────────────────────────────────────────
API_PORT=5080
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000

# ── Runtime ──────────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── PostgreSQL ───────────────────────────────────────────────────────────────────────
POSTGRES_USER=shoppinglist
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_DB=shoppinglist
KEYCLOAK_DB=keycloak

DatabaseSettings__ConnectionString=Host=postgres;Port=5432;Database=shoppinglist;Username=shoppinglist;Password=local_dev_password_change_me
DatabaseSettings__MaxPoolSize=50
DatabaseSettings__CommandTimeoutSeconds=30

# ── Redis ────────────────────────────────────────────────────────────────────────────
RedisSettings__ConnectionString=redis:6379
# false so a Redis outage degrades the API to database-only rather than taking it down
RedisSettings__AbortOnConnectFail=false
RedisSettings__UseSsl=false
RedisSettings__InstanceName=shoppinglist
RedisSettings__DefaultTtlSeconds=300
# Jitter spreads expiry so a burst of keys cannot expire together and stampede the database
RedisSettings__TtlJitterSeconds=60

# ── Minio ────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local_dev_minio_change_me

MinioSettings__Endpoint=minio:9000
MinioSettings__AccessKey=minioadmin
MinioSettings__SecretKey=local_dev_minio_change_me
MinioSettings__BucketName=shopping-list-images
MinioSettings__UseSsl=false
# Presigned URLs are consumed by the caller's browser, so they must carry the host-visible
# address, not the internal service name.
MinioSettings__PublicEndpoint=localhost:9000
MinioSettings__PresignedUrlExpirySeconds=900
MinioSettings__MaxUploadBytes=5242880

# ── Keycloak ─────────────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local_dev_admin_change_me
# Pins the token issuer. Must match KeycloakSettings__Authority below, or token validation
# fails across the container boundary.
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Authority is the issuer as it appears in the token (host-visible).
# MetadataAddress is how the API resolves discovery (internal network).
# These differing on purpose is the fix for the Docker issuer mismatch — the alternative
# most implementations reach for is ValidateIssuer=false, which is a security hole.
KeycloakSettings__Authority=http://localhost:8080/realms/shopping-list
KeycloakSettings__MetadataAddress=http://keycloak:8080/realms/shopping-list/.well-known/openid-configuration
KeycloakSettings__TokenEndpoint=http://keycloak:8080/realms/shopping-list/protocol/openid-connect/token
KeycloakSettings__AdminBaseUrl=http://keycloak:8080
KeycloakSettings__Realm=shopping-list
KeycloakSettings__Audience=shopping-list-api
KeycloakSettings__ClientId=shopping-list-api
KeycloakSettings__ClientSecret=local-dev-client-secret-change-me
KeycloakSettings__RequireHttpsMetadata=false
# Tightened from the 5-minute default; there is no clock drift worth that much slack here
KeycloakSettings__ClockSkewSeconds=30

# ── Ollama (embeddings) ──────────────────────────────────────────────────────────────
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OllamaSettings__BaseUrl=http://ollama:11434
OllamaSettings__EmbeddingModel=nomic-embed-text
# Asserted against the pgvector column dimension at startup — a mismatch fails fast at
# boot instead of surfacing as an opaque Postgres error on first write.
OllamaSettings__EmbeddingDimensions=768
OllamaSettings__TimeoutSeconds=30
OllamaSettings__MaxRetries=3

# ── Search & ranking ─────────────────────────────────────────────────────────────────
# rrf | weighted. RRF is the default because cosine distance and ts_rank are on different
# scales and cannot be combined as raw scores without normalisation.
SearchSettings__Strategy=rrf
SearchSettings__RrfK=60
SearchSettings__VectorWeight=0.6
SearchSettings__TextWeight=0.4
# Rows taken from each branch before fusion
SearchSettings__CandidateLimit=50
SearchSettings__MaxPageSize=50
# Relevance floor on the vector branch. Cosine distance 0-2; lower is stricter.
# Without it an ANN index returns its k nearest rows even when none are near, so every
# search matches the whole corpus and "car tyres" comes back with bread and milk, ranked.
#
# 0.6 is measured on this corpus rather than guessed, and the two populations are far
# apart. Query-to-item distances for clearly related pairs, under nomic-embed-text:
#
#   bread            -> White Bread      0.26
#   fruit            -> Bananas          0.37
#   fruit            -> Strawberry jam   0.385
#   dairy products   -> Whole milk       0.386
#
# An unrelated query ("car tyres") produced no hit at all with the floor opened to 0.9,
# so nothing in the corpus sits closer than 0.9 to it. Related <= 0.39, unrelated >= 0.9,
# and 0.6 sits in the middle of that gap.
#
# An earlier value of 0.45 was carried over from a different sample corpus. It cut into
# the related population here: "breakfast", "cleaning" and "something to put on toast"
# all returned nothing, which reads as a broken search rather than a strict one. The
# exact distance of those looser associations was not swept, so 0.6 is chosen from the
# gap rather than from an exhaustive characterisation of its edges — raise it if a
# genuinely relevant query returns empty, lower it if unrelated items start appearing.
SearchSettings__MaxVectorDistance=0.48

# ── Ranking experiment (A/B) ─────────────────────────────────────────────────────────
# Deterministic per-user assignment: hash(userId + Key) % 100 < VariantSplit.
# Sticky per user, and the variant forms part of the Redis cache key — a variant-blind
# cache would serve control results to treatment users and silently invalidate the
# comparison.
#
# Enabled here because the experiment is part of what this project demonstrates. The
# application's own default is off: a service that ships mid-experiment by accident is a
# service whose ranking nobody can reason about. Turning it on is therefore a deliberate
# act of configuration, which is what this file is for.
SearchSettings__Experiment__Enabled=true
SearchSettings__Experiment__Key=search-ranking-v1
SearchSettings__Experiment__VariantSplit=50
SearchSettings__Experiment__ControlStrategy=rrf
SearchSettings__Experiment__TreatmentStrategy=weighted

# ── Rate limiting ────────────────────────────────────────────────────────────────────
# Partitioned per authenticated user, falling back to IP for anonymous callers.
RateLimitSettings__PermitLimit=100
RateLimitSettings__WindowSeconds=60
# Auth endpoints are stricter: they are the credential-stuffing surface
RateLimitSettings__AuthPermitLimit=10
RateLimitSettings__AuthWindowSeconds=60
RateLimitSettings__UploadPermitLimit=20
RateLimitSettings__UploadWindowSeconds=60

# ── Logging ──────────────────────────────────────────────────────────────────────────
SerilogSettings__LokiUrl=http://loki:3100
SerilogSettings__MinimumLevel=Information
SerilogSettings__ApplicationName=shopping-list-api

# ── Grafana ──────────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_dev_grafana_change_me
