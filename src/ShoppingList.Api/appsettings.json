{
  "//": "Non-secret defaults only. Every value that is environment-specific or sensitive comes from environment variables using the Section__Key convention, or from user-secrets locally. Requirement: no secrets in appsettings.json. The absence of connection strings, keys and passwords here is deliberate — this file is committed.",

  "AllowedHosts": "*",

  "DatabaseSettings": {
    "MaxPoolSize": 50,
    "CommandTimeoutSeconds": 30
  },

  "RedisSettings": {
    "AbortOnConnectFail": false,
    "UseSsl": false,
    "InstanceName": "shoppinglist",
    "DefaultTtlSeconds": 300,
    "TtlJitterSeconds": 60
  },

  "MinioSettings": {
    "BucketName": "shopping-list-images",
    "UseSsl": false,
    "PresignedUrlExpirySeconds": 900,
    "MaxUploadBytes": 5242880
  },

  "KeycloakSettings": {
    "Realm": "shopping-list",
    "Audience": "shopping-list-api",
    "ClientId": "shopping-list-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },

  "OllamaSettings": {
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimensions": 768,
    "TimeoutSeconds": 30,
    "MaxRetries": 3
  },

  "SearchSettings": {
    "Strategy": "rrf",
    "RrfK": 60,
    "VectorWeight": 0.6,
    "TextWeight": 0.4,
    "CandidateLimit": 50,
    "MaxPageSize": 50,
    "Experiment": {
      "Key": "search-ranking-v1",
      "VariantSplit": 50,
      "ControlStrategy": "rrf",
      "TreatmentStrategy": "weighted"
    }
  },

  "RateLimitSettings": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "UploadPermitLimit": 20,
    "UploadWindowSeconds": 60
  },

  "SerilogSettings": {
    "MinimumLevel": "Information",
    "ApplicationName": "shopping-list-api"
  }
}
